<!DOCTYPE html>
<html lang="zh-TW">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>英語教學進度與下週備課規劃儀錶板</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Chart.js -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <!-- SheetJS (xlsx) for direct Excel/CSV parsing -->
  <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            brand: {
              50: '#f0fdf4',
              100: '#dcfce7',
              500: '#22c55e',
              600: '#16a34a',
              700: '#15803d',
              800: '#166534',
              900: '#14532d',
            }
          }
        }
      }
    }
  </script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@300;400;500;600;700&display=swap');
    body {
      font-family: 'Noto Sans TC', sans-serif;
    }
    @media print {
      .no-print { display: none !important; }
      .print-only { display: block !important; }
      body { background: white; }
    }
  </style>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen">

  <!-- 頂部導航與標題 -->
  <header class="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
      <div class="flex items-center gap-3">
        <div class="p-2.5 bg-emerald-600 text-white rounded-xl shadow-sm">
          <i data-lucide="layout-dashboard" class="w-6 h-6"></i>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-xl font-bold text-slate-900 tracking-tight">英語教學進度與下週備課儀錶板</h1>
            <span class="bg-emerald-100 text-emerald-800 text-xs px-2.5 py-0.5 rounded-full font-medium">115學年度 第1學期</span>
          </div>
          <p class="text-xs text-slate-500 mt-0.5">即時授課成效追蹤 • 課堂常規診斷 • 下週差異化進度規劃</p>
        </div>
      </div>
      
      <!-- 功能快捷按鈕 -->
      <div class="flex items-center gap-2 flex-wrap w-full sm:w-auto">
        <button onclick="openModal('importModal')" class="flex items-center gap-1.5 px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium rounded-lg transition">
          <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-600"></i>
          匯入 Excel / Sheet
        </button>
        <button onclick="openModal('addModal')" class="flex items-center gap-1.5 px-3.5 py-2 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-medium rounded-lg shadow-sm transition">
          <i data-lucide="plus" class="w-4 h-4"></i>
          新增課堂紀錄
        </button>
        <button onclick="window.print()" class="flex items-center gap-1.5 px-3 py-2 bg-white border border-slate-200 hover:bg-slate-50 text-slate-600 text-xs font-medium rounded-lg transition">
          <i data-lucide="printer" class="w-4 h-4"></i>
          列印規劃表
        </button>
      </div>
    </div>
  </header>

  <!-- 主內容區 -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

    <!-- 第一區塊：核心指標 KPI 卡片 -->
    <section class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- 總授課班級數 -->
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">已記錄授課班級</p>
          <div class="flex items-baseline gap-2 mt-1">
            <h3 id="kpiClassCount" class="text-2xl font-bold text-slate-900">4</h3>
            <span class="text-xs text-slate-500">個班級</span>
          </div>
          <p id="kpiClassList" class="text-xs text-emerald-600 mt-1 font-medium truncate max-w-[180px]">604, 五平, 五辛, 五和</p>
        </div>
        <div class="p-3 bg-emerald-50 rounded-xl text-emerald-600">
          <i data-lucide="users" class="w-6 h-6"></i>
        </div>
      </div>

      <!-- 平均教學目標達成率 -->
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">平均目標達成率</p>
          <div class="flex items-baseline gap-2 mt-1">
            <h3 id="kpiAvgScore" class="text-2xl font-bold text-slate-900">3.5</h3>
            <span class="text-xs text-slate-400">/ 5.0 分</span>
          </div>
          <div class="flex items-center gap-1 mt-1 text-xs text-amber-600">
            <i data-lucide="trending-up" class="w-3.5 h-3.5"></i>
            <span>導覽與開學常規建立期</span>
          </div>
        </div>
        <div class="p-3 bg-amber-50 rounded-xl text-amber-600">
          <i data-lucide="target" class="w-6 h-6"></i>
        </div>
      </div>

      <!-- 待跟進常規與進度事項 -->
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">待跟進常規建立班級</p>
          <div class="flex items-baseline gap-2 mt-1">
            <h3 id="kpiPendingRoutine" class="text-2xl font-bold text-rose-600">3</h3>
            <span class="text-xs text-slate-500">班需補足常規</span>
          </div>
          <p class="text-xs text-rose-500 mt-1">五平、五辛、五和進度待補</p>
        </div>
        <div class="p-3 bg-rose-50 rounded-xl text-rose-600">
          <i data-lucide="alert-circle" class="w-6 h-6"></i>
        </div>
      </div>

      <!-- 行政備課待辦事項 -->
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
        <div>
          <p class="text-xs font-medium text-slate-500 uppercase tracking-wider">重要備課與行政待辦</p>
          <div class="flex items-baseline gap-2 mt-1">
            <h3 id="kpiActionCount" class="text-2xl font-bold text-indigo-600">2</h3>
            <span class="text-xs text-slate-500">項關鍵行動</span>
          </div>
          <p class="text-xs text-indigo-600 mt-1 truncate max-w-[180px]">學習單送印、加章卡準備</p>
        </div>
        <div class="p-3 bg-indigo-50 rounded-xl text-indigo-600">
          <i data-lucide="check-square" class="w-6 h-6"></i>
        </div>
      </div>
    </section>

    <!-- 第二區塊：🎯 下週教學進度規劃與行動策略專區 (核心功能) -->
    <section class="bg-gradient-to-br from-slate-900 to-slate-800 text-white rounded-2xl p-6 shadow-md border border-slate-700">
      <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4 mb-6 pb-4 border-b border-slate-700">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded text-xs font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">前瞻備課工作台</span>
            <h2 class="text-lg font-bold text-white">下週（第 2 週）教學排程與差異化因應策略</h2>
          </div>
          <p class="text-xs text-slate-400 mt-1">系統依據本週實際授課進度缺漏與評估數據，自動診斷各班落差並生成具體行動策略。</p>
        </div>
        <div class="flex items-center gap-2">
          <button onclick="exportWeeklyPlan()" class="px-3 py-1.5 bg-slate-700 hover:bg-slate-600 text-slate-200 text-xs font-medium rounded-lg transition flex items-center gap-1">
            <i data-lucide="copy" class="w-3.5 h-3.5"></i> 複製規劃純文字
          </button>
        </div>
      </div>

      <!-- 下週規劃的三大模組：各班差異化進度策略、行動清單、備課提醒 -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        
        <!-- 模組 1: 各班下週進度與常規補強指引 -->
        <div class="lg:col-span-2 space-y-4">
          <h3 class="text-sm font-semibold text-emerald-400 flex items-center gap-2">
            <i data-lucide="compass" class="w-4 h-4"></i> 各班差異化排程指引 (由本週進度智能推算)
          </h3>
          <div id="weeklyClassCards" class="grid grid-cols-1 md:grid-cols-2 gap-3">
            <!-- 動態生成班級卡片 -->
          </div>
        </div>

        <!-- 模組 2: 下週備課與行政執行待辦檢核清單 -->
        <div class="bg-slate-800/80 rounded-xl p-4 border border-slate-700 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-sm font-semibold text-indigo-400 flex items-center gap-2">
                <i data-lucide="list-todo" class="w-4 h-4"></i> 備課執行清單 (Checklist)
              </h3>
              <span id="todoProgress" class="text-xs bg-indigo-900/50 text-indigo-300 px-2 py-0.5 rounded font-mono">1/3 已完成</span>
            </div>
            <p class="text-xs text-slate-400 mb-3">包含本週備註事項與開學常規道具整備：</p>
            
            <div id="todoList" class="space-y-2.5 text-xs text-slate-300">
              <!-- 動態生成或預設之 TODO -->
            </div>
          </div>

          <!-- 新增待辦輸入框 -->
          <div class="mt-4 pt-3 border-t border-slate-700 flex gap-2">
            <input type="text" id="newTodoInput" placeholder="新增下週備課待辦..." class="bg-slate-900/80 border border-slate-600 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 flex-1">
            <button onclick="addCustomTodo()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 text-white text-xs rounded-lg font-medium transition">
              新增
            </button>
          </div>
        </div>
      </div>
    </section>

    <!-- 第三區塊：互動圖表視覺化分析 -->
    <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <!-- 圖表 1: 各班教學目標達成率評分 -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="text-sm font-bold text-slate-900">課堂重點教學目標達成率</h3>
            <p class="text-xs text-slate-500">1~5 分量表評估（各班目前表現）</p>
          </div>
          <span class="p-1.5 bg-slate-100 rounded text-slate-600"><i data-lucide="bar-chart-2" class="w-4 h-4"></i></span>
        </div>
        <div class="relative flex-1 min-h-[220px]">
          <canvas id="scoreChart"></canvas>
        </div>
      </div>

      <!-- 圖表 2: 學生課堂參與度分佈（互動、專注力、學習動機） -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="text-sm font-bold text-slate-900">學生課堂參與度綜合分析</h3>
            <p class="text-xs text-slate-500">課堂互動、專注力與學習動機統計</p>
          </div>
          <span class="p-1.5 bg-slate-100 rounded text-slate-600"><i data-lucide="activity" class="w-4 h-4"></i></span>
        </div>
        <div class="relative flex-1 min-h-[220px]">
          <canvas id="engagementChart"></canvas>
        </div>
      </div>

      <!-- 圖表 3: 各班開學常規與進度完成狀態 -->
      <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm flex flex-col">
        <div class="flex items-center justify-between mb-3">
          <div>
            <h3 class="text-sm font-bold text-slate-900">班級進度狀態結構</h3>
            <p class="text-xs text-slate-500">教學說明貼妥 / 印章單 / 待補規則</p>
          </div>
          <span class="p-1.5 bg-slate-100 rounded text-slate-600"><i data-lucide="pie-chart" class="w-4 h-4"></i></span>
        </div>
        <div class="relative flex-1 min-h-[220px]">
          <canvas id="statusPieChart"></canvas>
        </div>
      </div>
    </section>

    <!-- 第四區塊：授課紀錄總覽表格（支援篩選、搜尋與編輯） -->
    <section class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
      <div class="p-4 sm:p-5 border-b border-slate-200 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3 bg-slate-50/50">
        <div>
          <h3 class="text-base font-bold text-slate-900">授課歷程詳細紀錄總覽</h3>
          <p class="text-xs text-slate-500 mt-0.5">點擊各欄位可快速檢視詳細備註或進行修改</p>
        </div>

        <!-- 篩選與搜尋工具列 -->
        <div class="flex items-center gap-2 flex-wrap w-full sm:w-auto">
          <!-- 班級篩選 -->
          <select id="filterClass" onchange="renderTable()" class="px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-700 focus:outline-none focus:border-emerald-500">
            <option value="ALL">全部班級</option>
          </select>

          <!-- 達成率篩選 -->
          <select id="filterScore" onchange="renderTable()" class="px-2.5 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-700 focus:outline-none focus:border-emerald-500">
            <option value="ALL">全部達成率</option>
            <option value="4">4 分以上</option>
            <option value="3">3 分</option>
            <option value="UNRATED">尚未評分</option>
          </select>

          <!-- 搜尋框 -->
          <div class="relative">
            <i data-lucide="search" class="w-3.5 h-3.5 absolute left-2.5 top-2.5 text-slate-400"></i>
            <input type="text" id="searchKeyword" oninput="renderTable()" placeholder="搜尋實際進度、備註..." class="pl-8 pr-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-700 focus:outline-none focus:border-emerald-500 w-44">
          </div>
        </div>
      </div>

      <!-- 表格內容 -->
      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs text-slate-600">
          <thead class="bg-slate-100/70 text-slate-700 font-semibold uppercase tracking-wider border-b border-slate-200">
            <tr>
              <th class="py-3 px-4">授課日期</th>
              <th class="py-3 px-3">班級</th>
              <th class="py-3 px-3">預計進度</th>
              <th class="py-3 px-4">實際進度與常規建立</th>
              <th class="py-3 px-3">目標達成率</th>
              <th class="py-3 px-3">課堂參與度 (互動/專注/動機)</th>
              <th class="py-3 px-3">作業/缺席</th>
              <th class="py-3 px-4">備註事項</th>
              <th class="py-3 px-3 text-right">操作</th>
            </tr>
          </thead>
          <tbody id="recordTableBody" class="divide-y divide-slate-200">
            <!-- 動態生成資料列 -->
          </tbody>
        </table>
      </div>
      
      <!-- 表尾摘要資訊 -->
      <div class="p-3 bg-slate-50 border-t border-slate-200 text-xs text-slate-500 flex justify-between items-center">
        <span id="tableCountInfo">顯示 4 筆授課紀錄</span>
        <span class="text-slate-400 text-[11px]">資料來源：英語教學進度紀錄表 (回覆)</span>
      </div>
    </section>

  </main>

  <!-- Modal 1: 匯入資料 (Excel / CSV / Google Sheet) -->
  <div id="importModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-lg w-full p-6 shadow-2xl space-y-4">
      <div class="flex justify-between items-center pb-2 border-b border-slate-100">
        <h3 class="text-base font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="upload" class="w-5 h-5 text-emerald-600"></i>
          匯入教學紀錄資料
        </h3>
        <button onclick="closeModal('importModal')" class="text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <div class="space-y-4 text-xs">
        <!-- 檔案上傳區 -->
        <div>
          <label class="block font-medium text-slate-700 mb-1">上傳 Excel 或 CSV 檔案 (.xlsx, .xls, .csv)</label>
          <div class="border-2 border-dashed border-slate-300 hover:border-emerald-500 rounded-xl p-5 text-center cursor-pointer transition bg-slate-50" onclick="document.getElementById('fileUploadInput').click()">
            <i data-lucide="file-up" class="w-8 h-8 mx-auto text-slate-400 mb-2"></i>
            <p class="text-slate-600 font-medium">點擊選擇檔案，或將 Excel 檔案拖曳至此</p>
            <p class="text-slate-400 text-[11px] mt-1">支援 Google 表單直接匯出之試算表格式</p>
            <input type="file" id="fileUploadInput" accept=".xlsx, .xls, .csv" class="hidden" onchange="handleFileUpload(event)">
          </div>
        </div>

        <div class="relative flex py-1 items-center">
          <div class="flex-grow border-t border-slate-200"></div>
          <span class="flex-shrink mx-3 text-slate-400 text-[11px]">或直接貼上 CSV 文本</span>
          <div class="flex-grow border-t border-slate-200"></div>
        </div>

        <div>
          <textarea id="csvPasteArea" rows="4" placeholder="可直接將 Excel 內容複製後貼上在此處 (含標題列)..." class="w-full p-2.5 border border-slate-300 rounded-lg text-xs font-mono focus:outline-none focus:border-emerald-500"></textarea>
        </div>

        <div class="flex justify-end gap-2 pt-2">
          <button onclick="resetToInitialData()" class="px-3 py-1.5 text-xs text-slate-600 hover:bg-slate-100 rounded-lg transition">重設為初始表單資料</button>
          <button onclick="handleCsvPaste()" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white font-medium rounded-lg transition">解析並匯入</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Modal 2: 新增/編輯課堂紀錄 -->
  <div id="addModal" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-2xl max-w-xl w-full p-6 shadow-2xl space-y-4 max-h-[90vh] overflow-y-auto">
      <div class="flex justify-between items-center pb-2 border-b border-slate-100">
        <h3 id="formModalTitle" class="text-base font-bold text-slate-900 flex items-center gap-2">
          <i data-lucide="plus-circle" class="w-5 h-5 text-emerald-600"></i>
          新增授課紀錄
        </h3>
        <button onclick="closeModal('addModal')" class="text-slate-400 hover:text-slate-600">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="recordForm" onsubmit="saveRecord(event)" class="space-y-3 text-xs">
        <input type="hidden" id="recordId">
        
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-medium text-slate-700 mb-1">授課日期</label>
            <input type="date" id="inputDate" required class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:border-emerald-500">
          </div>
          <div>
            <label class="block font-medium text-slate-700 mb-1">授課班級</label>
            <input type="text" id="inputClass" required placeholder="例如：604, 五平, 五辛" class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:border-emerald-500">
          </div>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-medium text-slate-700 mb-1">預計進度</label>
            <input type="text" id="inputPlanned" placeholder="例如：導覽、Unit 1" class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:border-emerald-500">
          </div>
          <div>
            <label class="block font-medium text-slate-700 mb-1">目標達成率 (1~5 分)</label>
            <select id="inputScore" class="w-full p-2 border border-slate-300 rounded-lg focus:outline-none focus:border-emerald-500">
              <option value="">尚未評估</option>
              <option value="5">5 分 (完全達成)</option>
              <option value="4">4 分 (良好達成)</option>
              <option value="3">3 分 (尚可/部分達成)</option>
